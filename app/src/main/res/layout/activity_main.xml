<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Schermata del Menu con i Pulsanti -->
    <LinearLayout
        android:id="@+id/menu_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:background="#FFFFFF">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="enrico papi"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="48dp" />

        <Button
            android:id="@+id/btn_car"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="enrico papi car"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btn_verity"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="enrico papi verity"
            android:textSize="18sp" />

        <!-- Crediti nella Homepage -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@sorgio_real2 su tiktok"
            android:textSize="16sp"
            android:textColor="#666666"
            android:textStyle="italic" />
        
    </LinearLayout>

    <!-- Lettore Video -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:keepScreenOn="true"
        app:resize_mode="fit"
        app:use_controller="false"
        app:show_buffering="when_playing" />

    <!-- Scritta dei Crediti (visibile in alto dove hai cerchiato) -->
    <TextView
        android:id="@+id/tv_credits"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="200dp"
        android:text="crediti a:\n@www.besciamellacruda.com\nsu tiktok per il video"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textAlignment="center"
        android:visibility="gone"
        android:shadowColor="#000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4" />
</RelativeLayout>
